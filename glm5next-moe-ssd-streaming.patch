+#include "llama-moe-stream.h"
+
+#include "llama-impl.h"
+
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+
+#ifdef _WIN32
+#include <malloc.h>
+#else
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/resource.h>
+
+typedef bool (*ggml_backend_cuda_register_host_buffer_t)(void * buffer, size_t size);
+typedef void (*ggml_backend_cuda_unregister_host_buffer_t)(void * buffer);
+#endif
+
+static const uint32_t MOE_STREAM_IO_THREADS_DEFAULT = 9;
+static const uint32_t MOE_STREAM_IO_THREADS_MAX     = 48;
+static const int64_t  MOE_STREAM_HOT_DECAY_TOKENS   = 64;
+
+// O_DIRECT alignment: 4096 is a multiple of any device logical block size (512/4096), so it is
+// universally valid, and reading a few extra KB of head/tail padding per slab is negligible
+static const size_t MOE_STREAM_DIRECT_ALIGN = 4096;
+
+// saturating increment - route-hotness counters accumulate over a whole run and must not wrap
+static uint32_t sat_inc(uint32_t & c) {
+    if (c < UINT32_MAX - 1) {
+        c++;
+    }
+    return c;
+}
+
+// page-aligned allocation, required both for O_DIRECT reads and for Metal private-buffer uploads
+static void * moe_aligned_alloc(size_t n) {
+#ifdef _WIN32
+    return _aligned_malloc(n, MOE_STREAM_DIRECT_ALIGN);
+#else
+    void * p = nullptr;
+    if (posix_memalign(&p, MOE_STREAM_DIRECT_ALIGN, n) != 0) {
+        p = nullptr;
+    }
+    return p;
+#endif
+}
+
+static void moe_aligned_free(void * p) {
+#ifdef _WIN32
+    _aligned_free(p);
+#else
+    free(p);
+#endif
+}
+
+// read len bytes at file offset offs into staging (thread-safe positional read); staging must have
+// room for len (+ 2*MOE_STREAM_DIRECT_ALIGN when direct). returns a pointer to the len bytes
+// within staging, or nullptr on failure
+static const uint8_t * llama_moe_stream_pread(llama_file & file, uint8_t * staging, size_t len, size_t offs, bool direct) {
+#ifdef _WIN32
+    GGML_UNUSED(direct);
+    // no positional read primitive; serialize the seek+read pairs
+    static std::mutex io_mtx;
+    std::lock_guard<std::mutex> lock(io_mtx);
+    try {
+        file.seek(offs, SEEK_SET);
+        file.read_raw(staging, len);
+        return staging;
+    } catch (...) {
+        return nullptr;
+    }
+#else
+    const int fd = file.file_id();
+
+    if (direct) {
+        // O_DIRECT requires the offset, length, and buffer all block-aligned
+        const size_t a     = MOE_STREAM_DIRECT_ALIGN;
+        const size_t aoffs = offs & ~(a - 1);
+        const size_t head  = offs - aoffs;
+        const size_t total = ((head + len + a - 1)/a)*a;
+        ssize_t r;
+        do {
+            r = pread(fd, staging, total, aoffs);
+        } while (r < 0 && errno == EINTR);
+        if (r < 0 || (size_t) r < head + len) {
+            return nullptr;
+        }
+        return staging + head;
+    }
+
+    uint8_t * p    = staging;
+    size_t    left = len;
+    while (left > 0) {
+        const ssize_t r = pread(fd, p, left, offs);
+        if (r < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return nullptr;
+        }
+        if (r == 0) {
+            return nullptr; // unexpected EOF
+        }
+        p    += r;
+        offs += (size_t) r;
+        left -= (size_t) r;
+    }
+    return staging;
+#endif
+}
+
+// true iff all of the given exps tensors are this layer's cache tensors - guards against a second,
+// non-streamed expert group on the same layer index (e.g. grovemoe chexps)
+bool llama_moe_stream_layer::matches(const ggml_tensor * gate, const ggml_tensor * up,
+                                     const ggml_tensor * down, const ggml_tensor * gate_up) const {
+    auto is_cache = [this](const ggml_tensor * t) {
+        for (const auto & w : weights) {
+            if (w.cache == t) {
+                return true;
+            }
+        }
+        return false;
+    };
+
+    size_t n = 0;
+    for (const ggml_tensor * t : { gate, up, down, gate_up }) {
+        if (t == nullptr) {
+            continue;
+        }
+        if (!is_cache(t)) {
+            return false;
+        }
+        n++;
+    }
+
+    return n > 0 && n == weights.size();
+}
+
+ggml_tensor * llama_moe_stream_layer::stage_of(const ggml_tensor * cache) const {
+    for (const auto & w : weights) {
+        if (w.cache == cache) {
+            return w.stage;
+        }
+    }
+    return nullptr;
+}
+
+ggml_tensor * llama_moe_stream_layer::full_of(const ggml_tensor * cache) const {
+    for (const auto & w : weights) {
+        if (w.cache == cache) {
+            return w.full;
+        }
+    }
+    return nullptr;
+}
+
+// sizes the per-layer table and clamps the I/O thread count; workers are spawned lazily on first use
+llama_moe_stream::llama_moe_stream(uint32_t n_layer, uint32_t n_slots, int32_t n_io_threads, bool direct) : n_slots(n_slots) {
+    t_start_us = ggml_time_us();
+    if (const char * e = getenv("LLAMA_MOE_STREAM_STAGE")) {
+        use_staging = strcmp(e, "0") != 0;
+    }
+    layers.resize(n_layer);
+
+    this->n_io_threads = n_io_threads <= 0 ? MOE_STREAM_IO_THREADS_DEFAULT : n_io_threads;
+    this->n_io_threads = std::min<int32_t>(this->n_io_threads, MOE_STREAM_IO_THREADS_MAX);
+
+    n_demand_threads = this->n_io_threads;
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_DECODE_THREADS")) {
+        n_demand_threads = std::clamp<int32_t>(atoi(e), 1, MOE_STREAM_IO_THREADS_MAX);
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_STAGE_GUIDED")) {
+        stage_guided = strcmp(e, "0") != 0;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_PREFETCH")) {
+        prefetch_n = std::max(0, atoi(e));
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_PREFETCH_POOL")) {
+        prefetch_pool = std::max(0, atoi(e));
+    }
+    prefetch_dry = std::getenv("LLAMA_MOE_STREAM_PREFETCH_DRY") != nullptr;
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_STAGE_CACHE")) {
+        stage_use_cache = strcmp(e, "0") != 0;
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_STAGE_COPY_THREADS")) {
+        n_copy_threads = std::clamp(atoi(e), 1, 16);
+    }
+    if (const char * e = std::getenv("LLAMA_MOE_STREAM_STAGE_MIN_KB")) {
+        const size_t kb = (size_t) std::max(4L, atol(e));
+        stage_chunk_min = std::min(stage_chunk_max, (kb*1024 + MOE_STREAM_DIRECT_ALIGN - 1) & ~(MOE_STREAM_DIRECT_ALIGN - 1));
+    }
+
+    debug         = std::getenv("LLAMA_MOE_STREAM_DEBUG") != nullptr;
+    use_direct_io = direct;
+}
+
+// stop and join the I/O workers before the cache buffers and files they use are destroyed
+llama_moe_stream::~llama_moe_stream() {
+    {
+        std::lock_guard<std::mutex> lock(mtx);
+        shutting_down = true;
+        q_demand.clear();
+        q_prefetch.clear();
+    }
+    cv_work.notify_all();
+    for (auto & w : workers) {
+        w.join();
+    }
+    stage_join();
+    for (const auto & [reg, base] : stage_pinned) {
+        auto * fn = (ggml_backend_cuda_unregister_host_buffer_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_unregister_host_buffer");
+        if (fn != nullptr) {
+            fn(base);
+        }
+    }
+    for (uint8_t * b : stage_base) {
+        moe_aligned_free(b);
+    }
+}
+
+ggml_tensor * llama_moe_stream::create_cache_tensor(
+        int32_t il, ggml_backend_buffer_type_t buft, const ggml_tensor * meta,
+        uint16_t file_idx, size_t offs, ggml_tensor * full) {
+    GGML_ASSERT(il >= 0 && (size_t) il < layers.size());
+    GGML_ASSERT(ggml_is_contiguous(meta));
+    GGML_ASSERT(meta->ne[2] > 0 && meta->ne[3] == 1);
+
+    const uint32_t n_expert  = meta->ne[2];
+    const size_t   nb_expert = ggml_nbytes(meta) / n_expert;
+    GGML_ASSERT(nb_expert * n_expert == ggml_nbytes(meta));
+    GGML_ASSERT(n_slots > 0 && n_slots < n_expert);
+
+    ggml_context * ctx = nullptr;
+    for (auto & [cur_buft, cur_ctx] : ctxs) {
+        if (cur_buft == buft) {
+            ctx = cur_ctx.get();
+            break;
+        }
+    }
+    if (ctx == nullptr) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ ggml_tensor_overhead()*(layers.size()*4 + 1),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        ctx = ggml_init(params);
+        if (ctx == nullptr) {
+            throw std::runtime_error("failed to create ggml context for MoE expert streaming");
+        }
+        ctxs.emplace_back(buft, ctx);
+    }
+
+    ggml_tensor * cache = ggml_new_tensor_3d(ctx, meta->type, meta->ne[0], meta->ne[1], n_slots);
+    ggml_format_name(cache, "%s.stream_cache", meta->name);
+    GGML_ASSERT(ggml_nbytes(cache) == nb_expert * n_slots);
+
+    auto & sl = layers[il];
+    if (!sl) {
+        sl = std::make_unique<llama_moe_stream_layer>();
+        sl->mgr      = this;
+        sl->il       = il;
+        sl->n_expert = n_expert;
+        sl->n_slots  = n_slots;
+        sl->slot_expert  .resize(n_slots, -1);
+        sl->slot_state   .resize(n_slots, LLAMA_MOE_STREAM_SLOT_EMPTY);
+        sl->slot_claimed .resize(n_slots, 0);
+        sl->slot_parts_left.resize(n_slots, 0);
+        sl->slot_gen     .resize(n_slots, 0);
+        sl->slot_last_use.resize(n_slots, 0);
+        sl->route_hotness.resize(n_expert, 0);
+        sl->seen         .resize(n_expert, 0);
+        sl->keep         .resize(n_slots, 0);
+        sl->slot_prefetched.resize(n_slots, 0);
+        sl->pf_keep      .resize(n_slots, 0);
+    }
+    GGML_ASSERT(sl->n_expert == n_expert);
+
+    llama_moe_stream_weight wt;
+    wt.cache     = cache;
+    wt.full      = full;
+    wt.file_idx  = file_idx;
+    wt.offs      = offs;
+    wt.nb_expert = nb_expert;
+    wt.type      = meta->type;
+    wt.ne0       = meta->ne[0];
+    wt.ne1       = meta->ne[1];
+    wt.nb_full   = ggml_nbytes(meta);
+    {
+        // pieces per expert slab: LLAMA_MOE_STREAM_CHUNK_KB (default 1024), at most 8 per tensor
+        static const size_t chunk_kb = std::getenv("LLAMA_MOE_STREAM_CHUNK_KB") ? std::max(64L, atol(std::getenv("LLAMA_MOE_STREAM_CHUNK_KB"))) : 1024;
+        const size_t want = chunk_kb*1024;
+        int32_t n = (int32_t) std::min<size_t>(8, (nb_expert + want - 1)/want);
+        n = std::max(n, 1);
+        size_t cb = (nb_expert + n - 1)/n;
+        cb = (cb + MOE_STREAM_DIRECT_ALIGN - 1) & ~(MOE_STREAM_DIRECT_ALIGN - 1);
+        // with the rounding the last chunk may be empty; drop such chunks
+        while (n > 1 && (size_t) (n - 1)*cb >= nb_expert) {
+            n--;
+        }
+        wt.n_chunks    = n;
+        wt.chunk_bytes = cb;
+    }
+    sl->weights.push_back(wt);
+
+    max_nb_expert = std::max(max_nb_expert, nb_expert);
+
+    return cache;
+}
+
+void llama_moe_stream::alloc_bufs(bool no_alloc) {
+    for (auto & [buft, ctx_ptr] : ctxs) {
+        ggml_context * ctx = ctx_ptr.get();
+        if (ggml_get_first_tensor(ctx) == nullptr) {
+            continue;
+        }
+
+        ggml_backend_buffer_t buf;
+        if (no_alloc) {
+            buf = ggml_backend_buft_alloc_buffer(buft, /*size =*/ 0); // dummy buffer
+            for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+                t->buffer = buf;
+            }
+        } else {
+            buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+        }
+        if (buf == nullptr) {
+            throw std::runtime_error(format("unable to allocate %s buffer for MoE expert streaming", ggml_backend_buft_name(buft)));
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        bufs.emplace_back(buf);
+
+        LLAMA_LOG_INFO("%s: %12s expert cache size = %8.2f MiB (%u slots per layer)\n",
+                __func__, ggml_backend_buffer_name(buf), ggml_backend_buffer_get_size(buf) / 1024.0 / 1024.0, n_slots);
+    }
+}
+
+void llama_moe_stream::open_files(const std::vector<std::string> & paths) {
+    for (const auto & path : paths) {
+        if (path.empty()) {
+            throw std::runtime_error("MoE expert streaming requires a file-based model (not a stream/file descriptor)");
+        }
+    }
+
+    auto open_all = [&](bool direct) {
+        files.clear();
+        for (const auto & path : paths) {
+            files.emplace_back(new llama_file(path.c_str(), "rb", direct));
+        }
+    };
+
+    open_all(use_direct_io);
+    file_paths = paths;
+
+    auto open_mirror = [&]() {
+        mirror_files.clear();
+        mirror_every = 0;
+        const char * mdir = std::getenv("LLAMA_MOE_STREAM_MIRROR");
+        if (mdir == nullptr) {
+            return;
+        }
+        for (const auto & path : paths) {
+            const std::string base = path.substr(path.find_last_of("/\\") + 1);
+            const std::string mpath = std::string(mdir) + "/" + base;
+            try {
+                mirror_files.emplace_back(new llama_file(mpath.c_str(), "rb", use_direct_io));
+            } catch (const std::exception & e) {
+                LLAMA_LOG_WARN("%s: mirror file %s not usable (%s), mirror disabled\n", __func__, mpath.c_str(), e.what());
+                mirror_files.clear();
+                return;
+            }
+        }
+        mirror_every = std::getenv("LLAMA_MOE_STREAM_MIRROR_EVERY") ? std::max(2, atoi(std::getenv("LLAMA_MOE_STREAM_MIRROR_EVERY"))) : 4;
+        mirror_decode_every = std::getenv("LLAMA_MOE_STREAM_MIRROR_DECODE") ? std::max(0, atoi(std::getenv("LLAMA_MOE_STREAM_MIRROR_DECODE"))) : 0;
+        if (const char * e = std::getenv("LLAMA_MOE_STREAM_STAGE_QUEUE")) {
+            stage_queue = strcmp(e, "0") != 0;
+        }
+        // how the staging readers are split between the two disks. the byte share follows from what
+        //   each disk delivers at that reader count, so this only has to be large enough to saturate
+        //   the mirror - half the readers each is a safe default
+        mirror_threads = std::getenv("LLAMA_MOE_STREAM_MIRROR_THREADS")
+            ? std::max(1, atoi(std::getenv("LLAMA_MOE_STREAM_MIRROR_THREADS")))
+            : std::max(1, n_io_threads/2);
+        if (const char * e = std::getenv("LLAMA_MOE_STREAM_DECODE_QUEUE")) {
+            decode_queue = strcmp(e, "0") != 0;
+        }
+        // the demand workers are split like the staging readers unless set on their own; the byte share
+        //   again follows from what each disk delivers, so this only has to keep the mirror busy
+        mirror_decode_threads = std::getenv("LLAMA_MOE_STREAM_MIRROR_DECODE_THREADS")
+            ? std::max(1, atoi(std::getenv("LLAMA_MOE_STREAM_MIRROR_DECODE_THREADS")))
+            : std::max(1, (int32_t) ((int64_t) mirror_threads*n_demand_threads/std::max(1, n_io_threads)));
+        std::string dec;
+        if (mirror_decode_every > 0) {
+            dec = decode_queue
+                ? ", decode queue with " + std::to_string(std::min(n_demand_threads - 1, mirror_decode_threads)) + " of " +
+                  std::to_string(n_demand_threads) + " demand workers on the mirror"
+                : ", every " + std::to_string(mirror_decode_every) + ". demand piece from the mirror";
+        }
+        if (stage_queue) {
+            LLAMA_LOG_WARN("%s: mirror active: %s, staging queue with %d of %d readers on the mirror%s\n",
+                    __func__, mdir, std::min(n_io_threads - 1, mirror_threads), n_io_threads, dec.c_str());
+        } else {
+            LLAMA_LOG_WARN("%s: mirror active: %s, every %d. staging chunk read from the mirror%s\n", __func__, mdir, mirror_every, dec.c_str());
+        }
+    };
+
+    // fall back to buffered when O_DIRECT is unusable: either the open did not honor it (macOS,
+    // Windows, unsupported filesystems), or it opened but a probe read fails (some network/overlay
+    // filesystems accept the flag then reject aligned reads). reopening is needed because O_DIRECT
+    // is a property of the fd. done here, single-threaded, before any worker starts.
+    if (use_direct_io) {
+        bool ok = !files.empty() && files.front()->has_direct_io();
+        if (ok) {
+            uint8_t * probe = (uint8_t *) moe_aligned_alloc(MOE_STREAM_DIRECT_ALIGN);
+            GGML_ASSERT(probe != nullptr);
+            ok = llama_moe_stream_pread(*files.front(), probe, MOE_STREAM_DIRECT_ALIGN, 0, /*direct =*/ true) != nullptr;
+            moe_aligned_free(probe);
+        }
+        if (!ok) {
+            LLAMA_LOG_WARN("%s: O_DIRECT not usable, falling back to buffered streaming reads\n", __func__);
+            use_direct_io = false;
+            open_all(false);
+        }
+    }
+
+    if (use_direct_io) {
+        LLAMA_LOG_INFO("%s: MoE expert streaming uses O_DIRECT (page cache bypassed)\n", __func__);
+    }
+    open_mirror(); // after the direct/buffered decision, same mode as the primary files
+
+    // one token drives ~one remap per streamed layer, so decaying every 64 tokens is
+    //   64 * n_streamed_layers remap calls (computed once here, off the hot path)
+    int64_t n_streamed = 0;
+    for (const auto & sl : layers) {
+        n_streamed += sl != nullptr;
+    }
+    hot_decay_interval = MOE_STREAM_HOT_DECAY_TOKENS * n_streamed;
+}
+
+// spawn the I/O thread pool on first use (from the remap callback, under mtx)
+void llama_moe_stream::start_workers_locked() {
+    if (workers_started) {
+        return;
+    }
+    workers_started = true;
+    workers.reserve(n_demand_threads);
+    for (int32_t i = 0; i < n_demand_threads; i++) {
+        workers.emplace_back([this, i]() { worker_loop(i); });
+    }
+}
+
+// I/O worker: pops a reserved load, reads its expert slab(s) from the GGUF file into the cache
+// slot, and marks the slot RESIDENT (or flags load_failed); stale/duplicate items are skipped
+//
+// with a mirror in decode queue mode, workers 0 .. n_mir-1 read only from the mirror and the rest only
+//   from the primary disk. all of them pop the same queue, so each disk serves pieces at the rate it
+//   actually delivers and a token's pieces finish on both disks at about the same moment. the older
+//   fixed share (every mirror_decode_every-th piece off the mirror) sent 7 of the 13 pieces of an
+//   expert to the slower disk, which then set the stall of every token - and it cannot adapt when one
+//   disk is slowed down (thermal throttling, a link trained below its speed, other load)
+void llama_moe_stream::worker_loop(int32_t idx) {
+    // page-aligned staging (Metal private buffers require page-aligned source + page-multiple
+    // length; O_DIRECT needs the extra head/tail slack for its aligned reads)
+    uint8_t * staging = (uint8_t *) moe_aligned_alloc(max_nb_expert + 2*MOE_STREAM_DIRECT_ALIGN);
+    GGML_ASSERT(staging != nullptr);
+
+    // at least one worker has to stay on the primary disk, so a single worker means no mirror
+    const bool use_mirror  = !mirror_files.empty() && mirror_decode_every > 0;
+    const int32_t n_mir    = use_mirror && decode_queue ? std::min(n_demand_threads - 1, std::max(1, mirror_decode_threads)) : 0;
+    const bool pool_mirror = idx < n_mir;
+    // prefetches overlap the expert compute of the decode instead of its wait, so what they cost the CPU
+    //   counts: a read off the LUKS-encrypted primary disk is decrypted by kcryptd on the very cores the
+    //   expert GEMMs run on. with prefetch_pool 1 only the mirror workers (plain disk, no decryption)
+    //   take prefetches
+    const bool may_prefetch = prefetch_pool == 0 || n_mir == 0 || pool_mirror;
+
+    std::unique_lock<std::mutex> lk(mtx);
+    while (true) {
+        cv_work.wait(lk, [&]{ return shutting_down || !q_demand.empty() || (may_prefetch && !q_prefetch.empty()); });
+        if (shutting_down) {
+            break;
+        }
+
+        // demand loads (a router is waiting for them) always go before prefetches
+        auto & q = !q_demand.empty() ? q_demand : q_prefetch;
+        llama_moe_stream_work w = q.front();
+        q.pop_front();
+
+        auto & sl = *w.sl;
+        const uint32_t bit = 1u << (w.part*8 + w.chunk);
+        if (w.gen != sl.slot_gen[w.slot] ||
+            sl.slot_state[w.slot] != LLAMA_MOE_STREAM_SLOT_LOADING ||
+            sl.slot_expert[w.slot] != w.expert ||
+            (sl.slot_claimed[w.slot] & bit)) {
+            continue; // stale item, or this part is already claimed/done
+        }
+        sl.slot_claimed[w.slot] |= bit;
+
+        lk.unlock();
+
+        const auto & wt = sl.weights[w.part];
+        const size_t coff = (size_t) w.chunk*wt.chunk_bytes;
+        const size_t clen = std::min(wt.chunk_bytes, wt.nb_expert - coff);
+        const bool from_mirror = use_mirror && (decode_queue ? pool_mirror : ((w.part*8 + w.chunk) % mirror_decode_every) == 0);
+        llama_file & src = from_mirror ? *mirror_files[wt.file_idx] : *files[wt.file_idx];
+        const uint8_t * data = llama_moe_stream_pread(src, staging, clen, wt.offs + (size_t) w.expert*wt.nb_expert + coff, use_direct_io);
+        const bool ok = data != nullptr;
+        if (ok) {
+            ggml_backend_tensor_set(wt.cache, data, (size_t) w.slot*wt.nb_expert + coff, clen);
+        }
+
+        lk.lock();
+
+        if (ok) {
+            stats.n_demand_bytes += (int64_t) clen;
+            if (from_mirror) {
+                stats.n_demand_bytes_mirror += (int64_t) clen;
+            }
+        }
+        if (!ok) {
+            load_failed = true;
+        } else if (w.gen == sl.slot_gen[w.slot] && sl.slot_state[w.slot] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+            GGML_ASSERT(sl.slot_parts_left[w.slot] > 0);
+            if (--sl.slot_parts_left[w.slot] == 0) {
+                sl.slot_state[w.slot] = LLAMA_MOE_STREAM_SLOT_RESIDENT;
+            }
+        }
+        cv_done.notify_all();
+    }
+    lk.unlock();
+
+    moe_aligned_free(staging);
+}
+
+// least valuable evictable slot: empty first, then coldest resident (min route hotness, oldest use
+// as tiebreak); LOADING and keep slots are never candidates. returns -1 when no candidate exists
+int32_t llama_moe_stream::pick_victim_locked(llama_moe_stream_layer & sl, const uint8_t * keep) const {
+    int32_t v = -1;
+
+    for (uint32_t s = 0; s < sl.n_slots; s++) {
+        if ((keep && keep[s]) || sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+            continue;
+        }
+        if (sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_EMPTY) {
+            return s;
+        }
+        if (v < 0) {
+            v = s;
+            continue;
+        }
+        const uint32_t hs = sl.route_hotness[sl.slot_expert[s]];
+        const uint32_t hv = sl.route_hotness[sl.slot_expert[v]];
+        if (hs < hv || (hs == hv && sl.slot_last_use[s] < sl.slot_last_use[v])) {
+            v = s;
+        }
+    }
+
+    return v;
+}
+
+// bind expert -> slot and mark it LOADING: evict the slot's prior occupant, bump slot_gen (so any
+// in-flight load for the old occupant is recognized as stale), and update the expert_slot index
+void llama_moe_stream::reserve_slot_locked(llama_moe_stream_layer & sl, int32_t expert, int32_t slot) {
+    if (sl.slot_prefetched[slot]) {
+        stats.n_pf_wasted++; // a prefetched expert leaves the cache before any router selected it
+        sl.slot_prefetched[slot] = 0;
+    }
+    if (sl.slot_expert[slot] >= 0) {
+        if (debug) {
+            LLAMA_LOG_DEBUG("%s: layer %d: evict expert %d from slot %d\n", __func__, sl.il, sl.slot_expert[slot], slot);
+        }
+        sl.expert_slot.erase(sl.slot_expert[slot]);
+    }
+
+    sl.slot_expert[slot] = expert;
+    sl.slot_state[slot]  = LLAMA_MOE_STREAM_SLOT_LOADING;
+    sl.slot_gen[slot]++;
+    sl.slot_claimed[slot]    = 0;
+    uint32_t n_pieces = 0;
+    for (const auto & wt : sl.weights) {
+        n_pieces += wt.n_chunks;
+    }
+    GGML_ASSERT(n_pieces <= 32 && n_pieces < 256);
+    sl.slot_parts_left[slot] = (uint8_t) n_pieces;
+    sl.slot_last_use[slot] = ++sl.use_counter;
+    sl.expert_slot[expert] = slot;
+    sl.seen[expert] = 1;
+}
+
+// queue the load of every weight part of (expert -> slot); duplicates for a slot that is already
+//   loading are harmless, the workers skip parts that are claimed or done
+void llama_moe_stream::enqueue_load_locked(llama_moe_stream_layer & sl, int32_t expert, int32_t slot, bool prefetch) {
+    GGML_ASSERT(sl.weights.size() <= 4);
+    auto & q = prefetch ? q_prefetch : q_demand;
+    for (int32_t k = 0; k < (int32_t) sl.weights.size(); k++) {
+        for (int32_t ch = 0; ch < sl.weights[k].n_chunks; ch++) {
+            q.push_back({ &sl, expert, slot, sl.slot_gen[slot], k, ch });
+        }
+    }
+    cv_work.notify_all();
+}
+
+// reserve and queue (low priority) the predicted experts of a decode step that are not yet in the cache.
+//   the predicted experts that are already there are protected from this call's own evictions; victims
+//   are otherwise chosen exactly as for a demand load (coldest first), and a prefetch never waits
+void llama_moe_stream::prefetch_locked(llama_moe_stream_layer & sl, const int32_t * ids, int64_t n) {
+    start_workers_locked();
+
+    std::fill(sl.pf_keep.begin(), sl.pf_keep.end(), 0);
+    for (int64_t i = 0; i < n; i++) {
+        const auto it = sl.expert_slot.find(ids[i]);
+        if (it != sl.expert_slot.end()) {
+            sl.pf_keep[it->second] = 1;
+        }
+    }
+    bool queued = false;
+    for (int64_t i = 0; i < n; i++) {
+        const int32_t e = ids[i];
+        if (e < 0 || (uint32_t) e >= sl.n_expert || sl.expert_slot.find(e) != sl.expert_slot.end()) {
+            continue; // resident, loading, or predicted twice in this batch
+        }
+        const int32_t v = pick_victim_locked(sl, sl.pf_keep.data());
+        if (v < 0) {
+            break;
+        }
+        reserve_slot_locked(sl, e, v);
+        sl.slot_prefetched[v] = 1;
+        sl.pf_keep[v] = 1;
+        for (int32_t k = 0; k < (int32_t) sl.weights.size(); k++) {
+            for (int32_t ch = 0; ch < sl.weights[k].n_chunks; ch++) {
+                q_prefetch.push_back({ &sl, e, v, sl.slot_gen[v], k, ch });
+            }
+        }
+        stats.n_pf_issued++;
+        queued = true;
+    }
+    if (queued) {
+        cv_work.notify_all();
+    }
+}
+
+void llama_moe_stream_prefetch(ggml_tensor * dst, const ggml_tensor * a, const ggml_tensor * b, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    GGML_UNUSED(b);
+    if (ith != 0) {
+        return;
+    }
+    GGML_ASSERT(a->type == GGML_TYPE_I32 && ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_nbytes(dst) == ggml_nbytes(a));
+    memcpy(dst->data, a->data, ggml_nbytes(a));
+
+    auto * sl  = (llama_moe_stream_layer *) userdata;
+    auto * mgr = sl->mgr;
+    if (mgr->prefetch_dry) {
+        return; // diagnostic: the prediction runs, nothing is loaded
+    }
+    std::lock_guard<std::mutex> lk(mgr->mtx);
+    if (mgr->load_failed) {
+        return; // the next remap reports it
+    }
+    mgr->prefetch_locked(*sl, (const int32_t *) a->data, ggml_nelements(a));
+}
+
+size_t llama_moe_stream::size_bufs() const {
+    size_t size = 0;
+    for (const auto & buf : bufs) {
+        size += ggml_backend_buffer_get_size(buf.get());
+    }
+    return size;
+}
+
+void llama_moe_stream::print_stats() const {
+    std::lock_guard<std::mutex> lock(mtx);
+
+    const int64_t n_touched = stats.n_hit + stats.n_miss;
+    LLAMA_LOG_INFO("%s: moe stream: remap calls = %" PRId64 ", expert hits = %" PRId64 ", misses = %" PRId64 " (%" PRId64 " cold), hit rate = %.2f%%\n",
+            __func__, stats.n_calls, stats.n_hit, stats.n_miss, stats.n_miss_cold,
+            n_touched > 0 ? 100.0*stats.n_hit/n_touched : 0.0);
+    LLAMA_LOG_INFO("%s: moe stream: load stall = %.2f ms total (%.3f ms per remap call)\n",
+            __func__, stats.t_stall_us/1000.0, stats.n_calls > 0 ? stats.t_stall_us/1000.0/stats.n_calls : 0.0);
+    if (stage_stats.n_layers > 0) {
+        const int64_t n_mirror = stage_stats.n_bytes_mirror.load(std::memory_order_relaxed);
+        LLAMA_LOG_INFO("%s: moe stream: staged layers = %" PRId64 " (%" PRId64 " prefetched), %.1f GiB read (%.1f%% off the mirror), wait = %.2f ms total (%.1f ms per layer), device sync = %.2f ms total\n",
+                __func__, stage_stats.n_layers, stage_stats.n_prefetch, stage_stats.n_bytes/1073741824.0,
+                stage_stats.n_bytes > 0 ? 100.0*n_mirror/stage_stats.n_bytes : 0.0,
+                stage_stats.t_wait_us/1000.0, stage_stats.t_wait_us/1000.0/stage_stats.n_layers, stage_stats.t_sync_us/1000.0);
+        LLAMA_LOG_INFO("%s: moe stream: staging copied %.1f GiB out of the RAM expert cache instead of reading it (%" PRId64 " copies went stale and were re-read)\n",
+                __func__, stage_stats.n_bytes_cache/1073741824.0, stage_stats.n_copy_stale);
+    }
+    if (stats.n_pf_issued > 0) {
+        LLAMA_LOG_INFO("%s: moe stream: decode prefetch issued %" PRId64 " expert loads, %" PRId64 " used (%.1f%%), %" PRId64 " evicted unused\n", __func__,
+                stats.n_pf_issued, stats.n_pf_used, 100.0*stats.n_pf_used/stats.n_pf_issued, stats.n_pf_wasted);
+    }
+    if (stats.n_demand_bytes > 0) {
+        LLAMA_LOG_INFO("%s: moe stream: demand loads read %.1f GiB (%.1f%% off the mirror)\n", __func__,
+                stats.n_demand_bytes/1073741824.0, 100.0*stats.n_demand_bytes_mirror/stats.n_demand_bytes);
+    }
+    if (stats.n_wave_calls > 0) {
+        LLAMA_LOG_INFO("%s: moe stream: waves = %" PRId64 " (%" PRId64 " non-empty), preloads issued = %" PRId64 " (ready on arrival = %" PRId64 "), wave stall = %.2f ms\n",
+                __func__, stats.n_wave_calls, stats.n_waves_run, stats.n_preload_issued, stats.n_preload_ready, stats.t_stall_wave_us/1000.0);
+    }
+}
+
+// ---- full-layer staging for large batches ------------------------------------------------------
+
+void llama_moe_stream::alloc_staging() {
+    if (!use_staging) {
+        return;
+    }
+    // region layout: one region per weight index (gate/up/down or gate_up/down), sized for the largest
+    //   layer; the tensor bytes land at region + (file offset % ALIGN) so that an aligned O_DIRECT read
+    //   of the file range can go straight into the region
+    const size_t a = MOE_STREAM_DIRECT_ALIGN;
+    size_t n_w = 0;
+    for (const auto & sl : layers) {
+        if (sl) {
+            n_w = std::max(n_w, sl->weights.size());
+        }
+    }
+    if (n_w == 0) {
+        return;
+    }
+    stage_region_size.assign(n_w, 0);
+    for (const auto & sl : layers) {
+        if (!sl) {
+            continue;
+        }
+        for (size_t k = 0; k < sl->weights.size(); k++) {
+            const auto & wt = sl->weights[k];
+            const size_t need = ((wt.offs & (a - 1)) + wt.nb_full + a - 1) & ~(a - 1);
+            stage_region_size[k] = std::max(stage_region_size[k], need);
+        }
+    }
+    stage_region_off.assign(n_w, 0);
+    stage_bytes = 0;
+    for (size_t k = 0; k < n_w; k++) {
+        stage_region_off[k] = stage_bytes;
+        stage_bytes += stage_region_size[k];
+    }
+
+    size_t n_tensors = 0;
+    for (const auto & sl : layers) {
+        n_tensors += sl ? sl->weights.size() : 0;
+    }
+    ggml_init_params params = {
+        /*.mem_size   =*/ ggml_tensor_overhead()*(n_tensors + 1),
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    stage_ctx.reset(ggml_init(params));
+    GGML_ASSERT(stage_ctx);
+
+    int32_t n_staged = 0;
+    for (const auto & sl : layers) {
+        n_staged += sl != nullptr;
+    }
+    // two sets: the layer being staged reads from one while the next layer is prefetched into the other.
+    //   which set a layer uses is decided when its prefetch starts (stage_assign_set), never statically:
+    //   the prefetch target is always the set the current layer does not use, so no distribution of
+    //   layers over sets (odd counts, wrap-around to the first layer) can alias the set being copied.
+    const int n_sets = 2;
+    for (int set = 0; set < n_sets; set++) {
+        uint8_t * base = (uint8_t *) moe_aligned_alloc(stage_bytes);
+        if (base == nullptr) {
+            throw std::runtime_error(format("unable to allocate %.2f MiB staging set for MoE expert streaming", stage_bytes/1024.0/1024.0));
+        }
+        stage_base.push_back(base);
+        // pin the set with every backend that can (CUDA: cudaHostRegister): op offload copies the staged
+        //   experts with an async host->device memcpy, and on HMM systems a memcpy from pageable memory
+        //   may return before the source is read - the next prefetch into this set would then race the copy.
+        //   pinned memory makes the copy stream-ordered, so the sync before the next CPU split covers it.
+        //   LLAMA_MOE_STREAM_NO_PIN=1 skips this (diagnostic).
+        if (std::getenv("LLAMA_MOE_STREAM_NO_PIN") == nullptr) {
+            for (size_t r = 0; r < ggml_backend_reg_count(); r++) {
+                ggml_backend_reg_t reg = ggml_backend_reg_get(r);
+                auto * fn = (ggml_backend_cuda_register_host_buffer_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_register_host_buffer");
+                if (fn != nullptr) {
+                    if (fn(base, stage_bytes)) {
+                        stage_pinned.push_back({ reg, base });
+                        LLAMA_LOG_WARN("%s: staging set %d (%.2f GiB) pinned with %s\n", __func__, set,
+                                stage_bytes/1073741824.0, ggml_backend_reg_name(reg));
+                    } else {
+                        // costs about 20 % of the prefill: op offload then copies every staged expert out of
+                        //   pageable memory. usually either GGML_CUDA_REGISTER_HOST is unset (the CUDA backend
+                        //   returns false right away) or RLIMIT_MEMLOCK is smaller than the two staging sets
+                        struct rlimit rl = { 0, 0 };
+                        getrlimit(RLIMIT_MEMLOCK, &rl);
+                        LLAMA_LOG_WARN("%s: staging set %d (%.2f GiB) could not be pinned with %s - the expert copies "
+                                "to the device stay on the slow pageable path. GGML_CUDA_REGISTER_HOST=1 set? "
+                                "memlock limit is %.2f GiB, %zu sets need %.2f GiB\n", __func__, set,
+                                stage_bytes/1073741824.0, ggml_backend_reg_name(reg),
+                                rl.rlim_cur == RLIM_INFINITY ? -1.0 : rl.rlim_cur/1073741824.0,
+                                stage_base.size(), stage_base.size()*stage_bytes/1073741824.0);
+                    }
+                }
+            }
+        }
+        ggml_backend_buffer_t buf = ggml_backend_cpu_buffer_from_ptr(base, stage_bytes);
+        GGML_ASSERT(buf != nullptr);
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        stage_bufs.emplace_back(buf);
+    }
+
+    int32_t order = 0;
+    for (auto & sl : layers) {
+        if (!sl) {
+            continue;
+        }
+        const int32_t set0 = order++ % 2; // initial assignment only, see stage_assign_set
+        for (size_t k = 0; k < sl->weights.size(); k++) {
+            auto & wt = sl->weights[k];
+            ggml_tensor * t = ggml_new_tensor_3d(stage_ctx.get(), wt.type, wt.ne0, wt.ne1, (int64_t) sl->n_expert);
+            ggml_format_name(t, "%s.stage", ggml_get_name(wt.cache));
+            wt.stage_off = stage_region_off[k];
+            uint8_t * addr = stage_base[set0] + wt.stage_off + (wt.offs & (a - 1));
+            ggml_backend_tensor_alloc(stage_bufs[set0].get(), t, addr);
+            wt.stage = t;
+        }
+        sl->stage_set = set0;
+    }
+
+    LLAMA_LOG_INFO("%s: full-layer staging for large batches: %d x %.2f MiB host staging sets for %d staged layers (%s reads)\n",
+            __func__, n_sets, stage_bytes/1024.0/1024.0, n_staged, use_direct_io ? "O_DIRECT" : "buffered");
+}
+
+// point the layer's staging tensors at the given set. called on the compute thread before the layer's
+//   prefetch starts, i.e. before the scheduler reads the tensors' data pointers for the device copy
+void llama_moe_stream::stage_assign_set(llama_moe_stream_layer & sl, int32_t set) {
+    GGML_ASSERT(set >= 0 && (size_t) set < stage_base.size());
+    const size_t a = MOE_STREAM_DIRECT_ALIGN;
+    for (auto & wt : sl.weights) {
+        wt.stage->data   = stage_base[set] + wt.stage_off + (wt.offs & (a - 1));
+        wt.stage->buffer = stage_bufs[set].get();
+    }
+    sl.stage_set = set;
+}
+
+llama_moe_stream_layer * llama_moe_stream::stage_next(int32_t il) const {
+    for (size_t i = il + 1; i < layers.size(); i++) {
+        if (layers[i] && layers[i]->has_stage()) {
+            return layers[i].get();
+        }
+    }
+    for (size_t i = 0; i < layers.size(); i++) { // wrap around: the next ubatch starts at the first layer again
+        if (layers[i] && layers[i]->has_stage()) {
+            return layers[i].get();
+        }
+    }
+    return nullptr;
+}
+
+void llama_moe_stream::stage_join() {
+    for (auto & t : stage_pending.threads) {
+        if (t.joinable()) {
+            t.join();
+        }
+    }
+    stage_pending.threads.clear();
+}
+
+// read the whole expert tensors of the layer into its staging set with n_io_threads threads reading
+//   large aligned chunks (the file ranges are contiguous per tensor); returns immediately
+//
+// with a mirror, the readers are split into a pool per disk and all of them pull from one shared
+//   queue, so each disk claims chunks at the rate it can actually serve them and both pools run dry
+//   at the same moment. the share of the bytes each disk gets is therefore its measured share of the
+//   bandwidth, not a number configured in advance. the older scheme - thread t takes chunk t, t+n_thr,
+//   ..., and chunk i comes off the mirror when i % mirror_every == 0 - could not do that: it fixes the
+//   byte share to 1/mirror_every (>= 50 %, the code clamps mirror_every to 2) and, worse, couples the
+//   two moduli. with 16 threads and mirror_every 2 every even thread reads only the mirror and every
+//   odd one only the primary disk, so each disk sees half the readers and an NVMe that needs 16
+//   concurrent readers for its full rate delivers well under it. kept behind LLAMA_MOE_STREAM_STAGE_QUEUE=0.
+void llama_moe_stream::stage_start_async(llama_moe_stream_layer & sl) {
+    GGML_ASSERT(stage_pending.il < 0 && stage_pending.threads.empty());
+    const size_t a  = MOE_STREAM_DIRECT_ALIGN;
+    const size_t CH = stage_chunk_max; // 32 MiB read chunks
+
+    const int  n_thr = std::max(1, n_io_threads);
+    const bool queue = stage_queue;
+
+    // chunk sizes: with the shared queue, a reader that claims one of the last 32 MiB chunks keeps its
+    //   disk busy for ~30 ms while the other readers have already run dry, and the layer is only
+    //   complete when that last read lands - about 7 % of every layer's read time went to this tail.
+    //   so the chunks shrink towards the end of the layer: each is 1/n_thr of what is still left
+    //   (guided self-scheduling), clamped to [stage_chunk_min, CH]. the file ranges and the order stay
+    //   the same, only the cut points move
+    const bool guided = queue && stage_guided;
+
+    // experts that are resident in the RAM expert cache are copied from there instead of read from disk
+    //   (stage_use_cache). only a plain CPU cache buffer holds the slabs in file layout - a repacking
+    //   buffer type would not. slot and generation are taken under the residency lock here and compared
+    //   again by stage_check_copies once the layer is complete
+    auto & copies = stage_pending.copies;
+    copies.clear();
+    std::vector<int32_t>  res_slot;
+    std::vector<uint64_t> res_gen;
+    if (stage_use_cache) {
+        res_slot.assign(sl.n_expert, -1);
+        res_gen.assign(sl.n_expert, 0);
+        std::lock_guard<std::mutex> lk(mtx);
+        for (const auto & [e, s] : sl.expert_slot) {
+            if (sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+                res_slot[e] = s;
+                res_gen[e]  = sl.slot_gen[s];
+            }
+        }
+    }
+
+    // disk ranges: per weight the runs of experts that are not copied, widened to the 4 KiB O_DIRECT grid.
+    //   a widened edge reaches less than 4 KiB into the neighbouring copied expert; that edge block then
+    //   belongs to the disk read alone and the copy leaves it out (see below)
+    struct stage_range { uint16_t file_idx; size_t off, len; uint8_t * dst; };
+    std::vector<stage_range> ranges;
+    size_t left = 0;
+    for (size_t k = 0; k < sl.weights.size(); k++) {
+        const auto & wt = sl.weights[k];
+        const size_t aoffs = wt.offs & ~(a - 1);
+        uint8_t * base = stage_base[sl.stage_set] + wt.stage_off; // file offset aoffs lands here
+        const bool from_cache = stage_use_cache && wt.cache->data != nullptr && wt.cache->buffer != nullptr &&
+            ggml_backend_buffer_get_type(wt.cache->buffer) == ggml_backend_cpu_buffer_type();
+        auto add_run = [&](int32_t e0, int32_t e1) { // experts [e0, e1) off the disk
+            const size_t lo = (wt.offs + (size_t) e0*wt.nb_expert) & ~(a - 1);
+            const size_t hi = (wt.offs + (size_t) e1*wt.nb_expert + a - 1) & ~(a - 1);
+            ranges.push_back({ wt.file_idx, lo, hi - lo, base + (lo - aoffs) });
+            left += hi - lo;
+        };
+        auto is_copy = [&](int32_t e) { return from_cache && e >= 0 && e < (int32_t) sl.n_expert && res_slot[e] >= 0; };
+        int32_t run0 = -1;
+        for (int32_t e = 0; e < (int32_t) sl.n_expert; e++) {
+            if (is_copy(e)) {
+                if (run0 >= 0) {
+                    add_run(run0, e);
+                    run0 = -1;
+                }
+                // a copy must never write into a 4 KiB block that a disk read also writes: dm-crypt
+                //   decrypts an O_DIRECT read in place in the destination buffer, so that block holds
+                //   ciphertext until the read completes and is then decrypted as a whole - copied
+                //   plaintext that landed in it meanwhile turns into garbage. so where a neighbour
+                //   comes off the disk, the copy leaves the shared edge block to the disk read (which
+                //   brings the very same file bytes)
+                const size_t S = wt.offs + (size_t) e*wt.nb_expert;
+                const size_t E = S + wt.nb_expert;
+                const size_t lo = e > 0 && !is_copy(e - 1) ? std::min(E, (S + a - 1) & ~(a - 1)) : S;
+                const size_t hi = e + 1 < (int32_t) sl.n_expert && !is_copy(e + 1) ? std::max(lo, E & ~(a - 1)) : E;
+                if (hi > lo) {
+                    copies.push_back({ (int32_t) k, e, res_slot[e], res_gen[e],
+                            (const uint8_t *) wt.cache->data + (size_t) res_slot[e]*wt.nb_expert + (lo - S),
+                            base + (lo - aoffs), hi - lo });
+                }
+            } else if (run0 < 0) {
+                run0 = e;
+            }
+        }
+        if (run0 >= 0) {
+            add_run(run0, (int32_t) sl.n_expert);
+        }
+    }
+
+    auto & chunks = stage_pending.chunks;
+    chunks.clear();
+    for (const auto & r : ranges) {
+        for (size_t o = 0; o < r.len; ) {
+            size_t len = CH;
+            if (guided) {
+                len = std::clamp(left/(size_t) n_thr, stage_chunk_min, CH);
+                len = (len + a - 1) & ~(a - 1);
+            }
+            len = std::min(len, r.len - o);
+            chunks.push_back({ r.file_idx, r.off + o, len, r.dst + o });
+            o    += len;
+            left -= len;
+        }
+        stage_stats.n_bytes += (int64_t) r.len;
+    }
+    for (const auto & c : copies) {
+        stage_stats.n_bytes_cache += (int64_t) c.len;
+    }
+
+    stage_pending.il = sl.il;
+    stage_pending.failed = false;
+    stage_pending.cursor.store(0, std::memory_order_relaxed);
+    stage_pending.copy_cursor.store(0, std::memory_order_relaxed);
+    // the cache copies run on their own threads, next to the readers: a reader that stopped for a copy
+    //   would leave its disk with one read less in flight
+    for (int t = 0; t < (copies.empty() ? 0 : n_copy_threads); t++) {
+        stage_pending.threads.emplace_back([this]() {
+            const auto & copies = stage_pending.copies;
+            for (;;) {
+                const size_t i = stage_pending.copy_cursor.fetch_add(1, std::memory_order_relaxed);
+                if (i >= copies.size()) {
+                    break;
+                }
+                memcpy(copies[i].dst, copies[i].src, copies[i].len);
+            }
+        });
+    }
+    // at least one reader has to stay on the primary disk, so a single I/O thread means no mirror
+    const int  n_mir = mirror_files.empty() ? 0 : std::min(n_thr - 1, std::max(1, mirror_threads));
+    for (int t = 0; t < n_thr; t++) {
+        const bool mir = t < n_mir;
+        stage_pending.threads.emplace_back([this, t, n_thr, mir, queue]() {
+            const auto & chunks = stage_pending.chunks;
+            int64_t mirror_bytes = 0;
+            size_t  i = (size_t) t;
+            for (;;) {
+                if (queue) {
+                    i = stage_pending.cursor.fetch_add(1, std::memory_order_relaxed);
+                }
+                if (i >= chunks.size() || stage_pending.failed.load(std::memory_order_relaxed)) {
+                    break;
+                }
+                const llama_moe_stage_chunk & c = chunks[i];
+                const bool from_mirror = queue ? mir : (mirror_every > 0 && (i % (size_t) mirror_every) == 0);
+                const int  fd = from_mirror ? mirror_files[c.file_idx]->file_id() : files[c.file_idx]->file_id();
+                size_t done = 0;
+                while (done < c.len) {
+                    const ssize_t r = pread(fd, c.dst + done, c.len - done, c.off + done);
+                    if (r < 0) {
+                        if (errno == EINTR) {
+                            continue;
+                        }
+                        stage_pending.failed = true;
+                        return;
+                    }
+                    if (r == 0) {
+                        stage_pending.failed = true;
+                        return;
+                    }
+                    done += (size_t) r;
+                }
+                if (from_mirror) {
+                    mirror_bytes += (int64_t) c.len;
+                }
+                if (!queue) {
+                    i += n_thr;
+                }
+            }
+            if (mirror_bytes > 0) {
+                stage_stats.n_bytes_mirror.fetch_add(mirror_bytes, std::memory_order_relaxed);
+            }
+        });
+    }
+}
+
+// the cache copies of a staged layer are only valid if every source slot still holds the same expert at
+//   the same generation now that the layer is complete: a prefetch can overlap a decode (the wrap-around
+//   prefetch of the first layer runs into the next ubatch, which may be a decode step whose demand loads
+//   evict and refill slots of that layer). whatever changed is read again from disk, synchronously.
+//   this is a deliberate optimistic scheme: a copy may read a slot while a demand load rewrites it (no
+//   lock is held during the memcpy, so the bytes can be torn), but every such rewrite is preceded by a
+//   generation bump under mtx, the check below runs after the copy threads are joined, and the re-read
+//   covers the whole slab - so a torn copy is always replaced before the layer is used
+void llama_moe_stream::stage_check_copies(llama_moe_stream_layer & sl) {
+    auto & copies = stage_pending.copies;
+    if (copies.empty()) {
+        return;
+    }
+    std::vector<size_t> stale;
+    {
+        std::lock_guard<std::mutex> lk(mtx);
+        for (size_t i = 0; i < copies.size(); i++) {
+            const auto & c = copies[i];
+            if (sl.slot_gen[c.slot] != c.gen || sl.slot_state[c.slot] != LLAMA_MOE_STREAM_SLOT_RESIDENT ||
+                sl.slot_expert[c.slot] != c.expert) {
+                stale.push_back(i);
+            }
+        }
+    }
+    const size_t a = MOE_STREAM_DIRECT_ALIGN;
+    for (const size_t i : stale) {
+        const auto & c  = copies[i];
+        const auto & wt = sl.weights[c.part];
+        const size_t aoffs = wt.offs & ~(a - 1);
+        const size_t lo    = (wt.offs + (size_t) c.expert*wt.nb_expert) & ~(a - 1);
+        const size_t hi    = (wt.offs + (size_t) (c.expert + 1)*wt.nb_expert + a - 1) & ~(a - 1);
+        uint8_t * dst = stage_base[sl.stage_set] + wt.stage_off + (lo - aoffs);
+        const int fd  = files[wt.file_idx]->file_id();
+        size_t done = 0;
+        while (done < hi - lo) {
+            const ssize_t r = pread(fd, dst + done, hi - lo - done, lo + done);
+            if (r < 0 && errno == EINTR) {
+                continue;
+            }
+            if (r <= 0) {
+                GGML_ABORT("MoE expert streaming: re-read of expert %d of layer %d failed", c.expert, sl.il);
+            }
+            done += (size_t) r;
+        }
+        stage_stats.n_bytes       += (int64_t) (hi - lo);
+        stage_stats.n_bytes_cache -= (int64_t) c.len; // came off the disk after all
+    }
+    stage_stats.n_copy_stale += (int64_t) stale.size();
+    copies.clear();
+}
+
+void llama_moe_stream::stage_layer(llama_moe_stream_layer & sl) {
+    std::lock_guard<std::mutex> lock(stage_mtx);
+    const int64_t t0 = ggml_time_us();
+
+    if (stage_pending.il == sl.il) {
+        stage_join();               // prefetched: wait for the arrival
+        stage_stats.n_prefetch++;
+    } else {
+        if (stage_pending.il >= 0) {
+            stage_join();           // a prefetch for another layer: let it finish, then read synchronously
+        }
+        stage_pending.il = -1;
+        stage_sync_devices();
+        stage_start_async(sl);
+        stage_join();
+    }
+    if (stage_pending.failed) {
+        GGML_ABORT("MoE expert streaming: staging read for layer %d failed", sl.il);
+    }
+    stage_check_copies(sl);
+    static const bool verify_stage = std::getenv("LLAMA_MOE_STREAM_VERIFY_STAGE") != nullptr;
+    if (verify_stage) {
+        // diagnostic: re-read every weight of the layer with plain buffered preads and compare
+        std::vector<uint8_t> tmp;
+        for (const auto & wt : sl.weights) {
+            tmp.resize(wt.nb_full);
+            const int vfd = open(file_paths[wt.file_idx].c_str(), O_RDONLY); // buffered, the streaming fds are O_DIRECT
+            size_t done = 0;
+            while (vfd >= 0 && done < wt.nb_full) {
+                const ssize_t r = pread(vfd, tmp.data() + done, wt.nb_full - done, wt.offs + done);
+                if (r <= 0) { LLAMA_LOG_WARN("%s: verify re-read failed for %s (%s)\n", __func__, ggml_get_name(wt.stage), strerror(errno)); break; }
+                done += (size_t) r;
+            }
+            if (vfd >= 0) { close(vfd); }
+            const uint8_t * staged = (const uint8_t *) wt.stage->data;
+            size_t first = SIZE_MAX, n_bad = 0;
+            for (size_t i = 0; i < wt.nb_full; i++) {
+                if (staged[i] != tmp[i]) { if (first == SIZE_MAX) first = i; n_bad++; }
+            }
+            if (n_bad) {
+                LLAMA_LOG_WARN("%s: STAGE MISMATCH layer %d %s: %zu bytes differ, first at %zu of %zu\n", __func__, sl.il, ggml_get_name(wt.stage), n_bad, first, wt.nb_full);
+            } else {
+                LLAMA_LOG_INFO("%s: stage verify layer %d %s ok\n", __func__, sl.il, ggml_get_name(wt.stage));
+            }
+        }
+    }
+    stage_pending.il = -1;
+    stage_stats.n_layers++;
+    stage_stats.t_wait_us += ggml_time_us() - t0;
+
+    // LLAMA_MOE_STREAM_STATS=1: one WARN line per pass over the streamed layers, so the staging
+    //   budget is visible during a run and not only in the perf summary at the end. splits the
+    //   wall time into "waited for the disks", "waited for the device before overwriting a set"
+    //   and the rest, which is the compute the prefetch overlapped with
+    static const bool log_stats = std::getenv("LLAMA_MOE_STREAM_STATS") != nullptr;
+    if (log_stats) {
+        static int64_t t_mark = 0, n_mark = 0, bytes_mark = 0, wait_mark = 0, sync_mark = 0, mir_mark = 0, t_last = 0, cache_mark = 0, stale_mark = 0;
+        int64_t n_streamed = 0;
+        for (const auto & l : layers) {
+            n_streamed += l && !l->weights.empty() ? 1 : 0;
+        }
+        // a window that spans an idle gap (the server waited for the next request, or decoded in
+        //   between) would count the gap as read time and report a far too low rate - after a gap the
+        //   window restarts behind this layer and the next line covers n_streamed busy layer loads
+        const int64_t now0 = ggml_time_us();
+        if (t_last > 0 && t0 - t_last > 2000000) {
+            t_mark = now0; n_mark = stage_stats.n_layers; bytes_mark = stage_stats.n_bytes;
+            wait_mark = stage_stats.t_wait_us; sync_mark = stage_stats.t_sync_us;
+            cache_mark = stage_stats.n_bytes_cache; stale_mark = stage_stats.n_copy_stale;
+            mir_mark = stage_stats.n_bytes_mirror.load(std::memory_order_relaxed);
+        }
+        t_last = now0;
+        if (n_streamed > 0 && stage_stats.n_layers - n_mark >= n_streamed) {
+            const int64_t now = ggml_time_us();
+            const double  dt  = (now - t_mark)/1e6;
+            const int64_t mir = stage_stats.n_bytes_mirror.load(std::memory_order_relaxed);
+            const double  gb  = (stage_stats.n_bytes - bytes_mark)/1e9;
+            if (t_mark > 0) {
+                LLAMA_LOG_WARN("moe stream staging: %" PRId64 " layers in %.2f s, %.1f GB at %.2f GB/s (%.0f%% mirror) | "
+                        "disk wait %.0f ms, device sync %.0f ms, compute %.0f ms per layer | %.1f GB from the RAM cache (%" PRId64 " stale)\n",
+                        stage_stats.n_layers - n_mark, dt, gb, gb/std::max(0.001, dt),
+                        gb > 0 ? 100.0*(mir - mir_mark)/1e9/gb : 0.0,
+                        (stage_stats.t_wait_us - wait_mark)/1000.0/(stage_stats.n_layers - n_mark),
+                        (stage_stats.t_sync_us - sync_mark)/1000.0/(stage_stats.n_layers - n_mark),
+                        (dt*1000.0 - (stage_stats.t_wait_us - wait_mark)/1000.0 - (stage_stats.t_sync_us - sync_mark)/1000.0)
+                            /(stage_stats.n_layers - n_mark),
+                        (stage_stats.n_bytes_cache - cache_mark)/1e9, stage_stats.n_copy_stale - stale_mark);
+            }
+            t_mark = now; n_mark = stage_stats.n_layers; bytes_mark = stage_stats.n_bytes;
+            wait_mark = stage_stats.t_wait_us; sync_mark = stage_stats.t_sync_us; mir_mark = mir;
+            cache_mark = stage_stats.n_bytes_cache; stale_mark = stage_stats.n_copy_stale;
+        }
+    }
+
+    // the other staging set was last used by the previous staged layer. the scheduler synchronizes the
+    //   device *before* it enqueues that layer's used-expert copies, not after: the copies are still queued
+    //   on the device stream when this op runs, and a cudaMemcpyAsync from pageable host memory is not
+    //   guaranteed to have consumed its source when it returns. so wait for the device before the I/O
+    //   threads overwrite the set, then prefetch the next layer into it.
+    // LLAMA_MOE_STREAM_NO_PREFETCH=1: diagnostic switch, read every layer synchronously (no double buffering)
+    static const bool no_prefetch = std::getenv("LLAMA_MOE_STREAM_NO_PREFETCH") != nullptr;
+    if (no_prefetch) {
+        return;
+    }
+    if (llama_moe_stream_layer * nx = stage_next(sl.il)) {
+        if (nx != &sl) {
+            // the next layer always goes into the set this layer does not use: the scheduler copies this
+            //   layer's experts from sl.stage_set right after this op, so that set must not be written.
+            //   the other set was last read by the previous staged layer; the device sync below
+            //   guarantees that copy has completed before the I/O threads overwrite it.
+            const int32_t target = 1 - sl.stage_set;
+            if (nx->stage_set != target) {
+                stage_assign_set(*nx, target);
+            }
+            GGML_ASSERT(nx->stage_set != sl.stage_set);
+            stage_sync_devices();
+            stage_start_async(*nx);
+        }
+    }
+}
+
+// wait until every device backend has finished the work queued so far (in particular the async
+//   host-to-device copies that read from the staging sets)
+void llama_moe_stream::stage_sync_devices() {
+    static const bool no_sync = std::getenv("LLAMA_MOE_STREAM_NO_SYNC") != nullptr; // diagnostic: reproduce the race
+    if (no_sync) {
+        return;
+    }
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        LLAMA_LOG_INFO("%s: device sync before staging overwrite active: %zu backend(s)\n", __func__, sync_backends.size());
+    }
+    const int64_t t0 = ggml_time_us();
+    for (ggml_backend_t b : sync_backends) {
+        ggml_backend_synchronize(b);
+    }
+    stage_stats.t_sync_us += ggml_time_us() - t0;
+}
+
+void llama_moe_stream_stage(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+    GGML_ASSERT(ggml_is_contiguous(a) && ggml_nbytes(dst) == ggml_nbytes(a));
+    memcpy(dst->data, a->data, ggml_nbytes(a));
+    auto * sl = (llama_moe_stream_layer *) userdata;
+    sl->mgr->stage_layer(*sl);
+}
+
+// custom-op callback (single-threaded on ith 0): given the router's expert ids, ensure every touched
+// expert is resident - reserving cache slots and demand-loading misses, stalling until they commit -
+// then rewrite each id to its cache slot. this only relabels ids, so the same experts are computed
+// in the same order; the result matches a non-streamed run (bit-exact when both paths use the same
+// kernels, as on CUDA; a CPU build that repacks the non-streamed weights can differ in the last bits).
+void llama_moe_stream_remap(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    auto * sl  = (llama_moe_stream_layer *) userdata;
+    auto * mgr = sl->mgr;
+
+    GGML_ASSERT(a->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_are_same_shape(a, dst));
+
+    const int64_t n = ggml_nelements(a);
+
+    const int32_t * ids = (const int32_t *) a->data;
+          int32_t * out = (int32_t *) dst->data;
+
+    std::unique_lock<std::mutex> lk(mgr->mtx);
+
+    if (mgr->load_failed) {
+        GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+    }
+
+    mgr->stats.n_calls++;
+    mgr->start_workers_locked();
+
+    // distinct experts touched by this ubatch, in first-use order
+    sl->touched.assign(sl->n_expert, 0);
+    sl->uniq.clear();
+    for (int64_t i = 0; i < n; i++) {
+        const int32_t e = ids[i];
+        GGML_ASSERT(e >= 0 && (uint32_t) e < sl->n_expert);
+        if (!sl->touched[e]) {
+            sl->touched[e] = 1;
+            sl->uniq.push_back(e);
+        }
+    }
+
+    if (sl->uniq.size() > sl->n_slots) {
+        GGML_ABORT("MoE expert streaming: layer %d needs %zu distinct experts but the cache has only %u slots; "
+                   "increase --moe-stream-cache or reduce the ubatch size (-ub)",
+                sl->il, sl->uniq.size(), sl->n_slots);
+    }
+
+    // route hotness for eviction; halved periodically so a formerly-hot expert ages out
+    for (const int32_t e : sl->uniq) {
+        sat_inc(sl->route_hotness[e]);
+    }
+    static const bool log_stats = std::getenv("LLAMA_MOE_STREAM_STATS") != nullptr;
+    // LLAMA_MOE_STREAM_STATS=1: one WARN line per 64 decoded tokens with the numbers of just those
+    //   tokens (hit rate, disk stall per token, bytes read per token and the rate the disks delivered
+    //   while the decode waited on them). none of them depend on idle time between requests, so a
+    //   watcher can compare them against fixed limits - a disk that falls back to a slower link or
+    //   throttles shows up as a stall per token several times the usual ~90 ms
+    if (log_stats && mgr->hot_decay_interval > 0 && mgr->stats.n_calls % mgr->hot_decay_interval == 0) {
+        static int64_t calls_mark = 0, hit_mark = 0, miss_mark = 0, stall_mark = 0, bytes_mark = 0, mbytes_mark = 0;
+        static int64_t pfi_mark = 0, pfu_mark = 0, pfw_mark = 0;
+        const auto & st = mgr->stats;
+        const double n_streamed = (double) mgr->hot_decay_interval/MOE_STREAM_HOT_DECAY_TOKENS;
+        const double n_tok      = (st.n_calls - calls_mark)/n_streamed;
+        const int64_t d_hit     = st.n_hit - hit_mark;
+        const int64_t d_miss    = st.n_miss - miss_mark;
+        const double  stall_ms  = (st.t_stall_us - stall_mark)/1000.0;
+        const double  gb        = (st.n_demand_bytes - bytes_mark)/1e9;
+        const int64_t n_touched = st.n_hit + st.n_miss;
+        const int64_t d_pfi = st.n_pf_issued - pfi_mark, d_pfu = st.n_pf_used - pfu_mark, d_pfw = st.n_pf_wasted - pfw_mark;
+        LLAMA_LOG_WARN("moe stream decode: %.0f tok | hit %.1f%%, stall %.1f ms/tok, read %.1f MB/tok at %.2f GB/s (%.0f%% mirror) | since start: hit %.1f%%, %" PRId64 " misses (%" PRId64 " cold)"
+                " | prefetch %.1f/tok, %" PRId64 " used, %" PRId64 " wasted\n",
+                n_tok, d_hit + d_miss > 0 ? 100.0*d_hit/(d_hit + d_miss) : 0.0,
+                n_tok > 0 ? stall_ms/n_tok : 0.0,
+                n_tok > 0 ? gb*1000.0/n_tok : 0.0,
+                stall_ms > 0 ? gb/(stall_ms/1000.0) : 0.0,
+                gb > 0 ? 100.0*(st.n_demand_bytes_mirror - mbytes_mark)/1e9/gb : 0.0,
+                n_touched > 0 ? 100.0*st.n_hit/n_touched : 0.0, st.n_miss, st.n_miss_cold,
+                n_tok > 0 ? d_pfi/n_tok : 0.0, d_pfu, d_pfw);
+        pfi_mark = st.n_pf_issued; pfu_mark = st.n_pf_used; pfw_mark = st.n_pf_wasted;
+        calls_mark = st.n_calls; hit_mark = st.n_hit; miss_mark = st.n_miss; stall_mark = st.t_stall_us;
+        bytes_mark = st.n_demand_bytes; mbytes_mark = st.n_demand_bytes_mirror;
+    }
+    if (mgr->hot_decay_interval > 0 && mgr->stats.n_calls % mgr->hot_decay_interval == 0) {
+        for (auto & sl2 : mgr->layers) {
+            if (sl2) {
+                for (auto & h : sl2->route_hotness) {
+                    h >>= 1;
+                }
+            }
+        }
+    }
+
+    // classify the touched experts; reserve and enqueue demand loads in deterministic order
+    std::fill(sl->keep.begin(), sl->keep.end(), 0);
+    sl->demand_slots.clear();
+
+    bool waited = false;
+    for (const int32_t e : sl->uniq) {
+        const auto it = sl->expert_slot.find(e);
+        if (it != sl->expert_slot.end()) {
+            const int32_t s = it->second;
+            if (sl->slot_state[s] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+                mgr->enqueue_load_locked(*sl, e, s); // promotes a prefetch still in flight to a demand load
+                waited = true;
+            }
+            if (sl->slot_prefetched[s]) {
+                mgr->stats.n_pf_used++;
+                sl->slot_prefetched[s] = 0;
+            }
+            mgr->stats.n_hit++;
+            sl->keep[s] = 1;
+            sl->demand_slots.push_back(s);
+        } else {
+            int32_t v;
+            while ((v = mgr->pick_victim_locked(*sl, sl->keep.data())) < 0) {
+                // every allowed slot is loading; wait for a commit and retry
+                mgr->cv_done.wait(lk);
+                if (mgr->load_failed) {
+                    GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+                }
+            }
+            if (!sl->seen[e]) {
+                mgr->stats.n_miss_cold++;
+            }
+            mgr->reserve_slot_locked(*sl, e, v);
+            mgr->enqueue_load_locked(*sl, e, v);
+            mgr->stats.n_miss++;
+            waited = true;
+            sl->keep[v] = 1;
+            sl->demand_slots.push_back(v);
+        }
+    }
+
+    if (waited) {
+        const int64_t t0 = ggml_time_us();
+        mgr->cv_done.wait(lk, [&]{
+            if (mgr->load_failed) {
+                return true;
+            }
+            for (const int32_t s : sl->demand_slots) {
+                if (sl->slot_state[s] != LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+                    return false;
+                }
+            }
+            return true;
+        });
+        if (mgr->load_failed) {
+            GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+        }
+        mgr->stats.t_stall_us += ggml_time_us() - t0;
+    }
+
+    for (int64_t i = 0; i < n; i++) {
+        const int32_t s = sl->expert_slot.at(ids[i]);
+        sl->slot_last_use[s] = ++sl->use_counter;
+        out[i] = s;
+    }
+}
+
+// stable per-wave userdata; grows lazily and records the per-wave expert capacity (set at build)
+llama_moe_stream_wave * llama_moe_stream_layer::wave_userdata(int32_t wave, uint32_t capacity) {
+    GGML_ASSERT(capacity >= 1 && capacity <= n_slots);
+    plan_capacity = capacity;
+    while ((size_t) wave >= wave_ud.size()) {
+        auto ud = std::make_unique<llama_moe_stream_wave>();
+        ud->sl   = this;
+        ud->wave = (int32_t) wave_ud.size();
+        wave_ud.push_back(std::move(ud));
+    }
+    return wave_ud[wave].get();
+}
+
+// wave 0 of a ubatch: record the distinct touched experts (sl.uniq, first-use order) and split them
+// into consecutive groups of plan_capacity, one group per wave (sl.expert_wave[e] = e's wave)
+void llama_moe_stream::plan_waves_locked(llama_moe_stream_layer & sl, const int32_t * ids, int64_t n) {
+    stats.n_calls++;
+    start_workers_locked();
+
+    sl.touched.assign(sl.n_expert, 0);
+    sl.uniq.clear();
+    for (int64_t i = 0; i < n; i++) {
+        const int32_t e = ids[i];
+        GGML_ASSERT(e >= 0 && (uint32_t) e < sl.n_expert);
+        if (!sl.touched[e]) {
+            sl.touched[e] = 1;
+            sl.uniq.push_back(e);
+        }
+    }
+
+    GGML_ASSERT(sl.plan_capacity > 0);
+    sl.expert_wave.assign(sl.n_expert, 0xff);
+    for (size_t i = 0; i < sl.uniq.size(); i++) {
+        GGML_ASSERT(i/sl.plan_capacity < 0xff);
+        sl.expert_wave[sl.uniq[i]] = (uint8_t) (i/sl.plan_capacity);
+    }
+    sl.plan_n_waves   = (uint32_t) ((sl.uniq.size() + sl.plan_capacity - 1)/sl.plan_capacity);
+    sl.plan_next_wave = 0;
+}
+
+// make wave w's expert slice (uniq[w*cap .. +count)) resident, waiting for its loads, and best-effort
+// preload the next wave so its loads overlap this wave's compute. leaves sl.demand_slots = this wave's
+// slots and sl.plan_pool = the resident parking pool (>= n_ids slots) the emit draws masked pairs from
+void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llama_moe_stream_layer & sl, int32_t w, uint32_t n_ids) {
+    const size_t first = (size_t) w*sl.plan_capacity;
+    const size_t count = first < sl.uniq.size() ? std::min<size_t>(sl.plan_capacity, sl.uniq.size() - first) : 0;
+
+    std::fill(sl.keep.begin(), sl.keep.end(), 0);
+    sl.demand_slots.clear();
+
+    // a small final wave has fewer than n_ids own slots; borrow the rest from the previous wave's
+    //   pool so every token row has n_ids distinct resident parking slots for its masked pairs
+    std::vector<int32_t> borrowed;
+    if (count < n_ids) {
+        GGML_ASSERT(sl.plan_pool.size() >= n_ids - count);
+        for (size_t i = 0; i < n_ids - count; i++) {
+            borrowed.push_back(sl.plan_pool[i]);
+            sl.keep[sl.plan_pool[i]] = 1; // parking slots must survive this wave's loads
+        }
+    }
+
+    // protect the next wave's already-resident experts so this wave's victims do not evict them
+    const size_t nfirst = first + sl.plan_capacity;
+    const size_t ncount = nfirst < sl.uniq.size() ? std::min<size_t>(sl.plan_capacity, sl.uniq.size() - nfirst) : 0;
+    for (size_t i = nfirst; i < nfirst + ncount; i++) {
+        const auto it = sl.expert_slot.find(sl.uniq[i]);
+        if (it != sl.expert_slot.end()) {
+            sl.keep[it->second] = 1;
+        }
+    }
+
+    // reserve and demand-load this wave's experts (per-expert, same path as the decode remap)
+    bool waited = false;
+    if (count > 0) {
+        stats.n_waves_run++;
+        for (size_t i = first; i < first + count; i++) {
+            const int32_t e  = sl.uniq[i];
+            const auto    it = sl.expert_slot.find(e);
+            if (it != sl.expert_slot.end()) {
+                // already in the cache (resident, or still loading from the previous wave's preload)
+                const int32_t s = it->second;
+                if (sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+                    enqueue_load_locked(sl, e, s); // promote to demand, wait for it
+                    waited = true;
+                } else {
+                    stats.n_preload_ready++; // resident from the previous wave's preload
+                }
+                stats.n_hit++;
+                sl.keep[s] = 1;
+                sl.demand_slots.push_back(s);
+            } else {
+                // miss: evict a non-kept slot and queue the load
+                int32_t v;
+                while ((v = pick_victim_locked(sl, sl.keep.data())) < 0) {
+                    cv_done.wait(lk);
+                    if (load_failed) {
+                        GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+                    }
+                }
+                if (!sl.seen[e]) {
+                    stats.n_miss_cold++;
+                }
+                reserve_slot_locked(sl, e, v);
+                enqueue_load_locked(sl, e, v);
+                stats.n_miss++;
+                waited = true;
+                sl.keep[v] = 1;
+                sl.demand_slots.push_back(v);
+            }
+        }
+    }
+
+    // best-effort preload of the next wave so its loads overlap this wave's compute; never waits,
+    //   whatever cannot be reserved now simply becomes the next wave's demand load
+    if (std::getenv("LLAMA_MOE_STREAM_NO_PRELOAD") == nullptr) {
+        for (size_t i = nfirst; i < nfirst + ncount; i++) {
+            const int32_t e = sl.uniq[i];
+            if (sl.expert_slot.find(e) != sl.expert_slot.end()) {
+                continue;
+            }
+            const int32_t v = pick_victim_locked(sl, sl.keep.data());
+            if (v < 0) {
+                continue;
+            }
+            if (!sl.seen[e]) {
+                stats.n_miss_cold++;
+            }
+            reserve_slot_locked(sl, e, v);
+            sl.keep[v] = 1;
+            enqueue_load_locked(sl, e, v);
+            stats.n_preload_issued++;
+        }
+    }
+
+    if (waited) {
+        const int64_t t0 = ggml_time_us();
+        cv_done.wait(lk, [&]{
+            if (load_failed) {
+                return true;
+            }
+            for (const int32_t s : sl.demand_slots) {
+                if (sl.slot_state[s] != LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+                    return false;
+                }
+            }
+            return true;
+        });
+        if (load_failed) {
+            GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+        }
+        stats.t_stall_wave_us += ggml_time_us() - t0;
+    }
+
+    // parking pool: this wave's own resident slots plus the borrowed ones (all keep-protected;
+    //   the next same-layer reservation is ordered after this wave's GEMMs by the graph)
+    sl.plan_pool = sl.demand_slots;
+    sl.plan_pool.insert(sl.plan_pool.end(), borrowed.begin(), borrowed.end());
+    GGML_ASSERT(sl.plan_pool.size() >= n_ids);
+}
+
+// write out[i] = the cache slot the GEMM should index for each (token, expert) pair of wave w, one
+// token row at a time: pairs whose expert is in this wave get its real slot; the rest park on distinct
+// resident pool slots (pool_used prevents a repeat within the row, required by the Metal kernel)
+void llama_moe_stream::emit_wave_slots(llama_moe_stream_layer & sl, const int32_t * ids, int32_t * out,
+        int32_t w, uint32_t n_ids, int64_t n_tok) {
+    for (int64_t t = 0; t < n_tok; t++) {
+        sl.pool_used.clear();
+
+        // pass 1: pairs whose expert belongs to this wave -> that expert's real (resident) slot
+        for (uint32_t kk = 0; kk < n_ids; kk++) {
+            const int64_t i = t*n_ids + kk;
+            const int32_t e = ids[i];
+            GGML_ASSERT(sl.expert_wave[e] != 0xff);
+            if (sl.expert_wave[e] == (uint8_t) w) {
+                const int32_t s = sl.expert_slot.at(e);
+                GGML_ASSERT(sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_RESIDENT);
+                sl.slot_last_use[s] = ++sl.use_counter;
+                out[i] = s;
+                sl.pool_used.push_back(s);
+            }
+        }
+
+        // pass 2: the remaining (masked) pairs -> the next pool slot not yet used in this row
+        size_t pi = 0;
+        for (uint32_t kk = 0; kk < n_ids; kk++) {
+            const int64_t i = t*n_ids + kk;
+            if (sl.expert_wave[ids[i]] == (uint8_t) w) {
+                continue;
+            }
+            while (std::find(sl.pool_used.begin(), sl.pool_used.end(), sl.plan_pool[pi]) != sl.pool_used.end()) {
+                pi++;
+                GGML_ASSERT(pi < sl.plan_pool.size());
+            }
+            GGML_ASSERT(sl.slot_state[sl.plan_pool[pi]] == LLAMA_MOE_STREAM_SLOT_RESIDENT);
+            out[i] = sl.plan_pool[pi];
+            sl.pool_used.push_back(sl.plan_pool[pi]);
+            pi++;
+        }
+    }
+}
+
+// Custom-op callback for one pass of multi-pass prefill. When a ubatch touches more experts than the
+// cache holds, build_moe_ffn runs the expert GEMMs in several waves; this runs once per wave (single-
+// threaded on ith 0), in wave order. For wave w it makes that wave's expert slice resident (preloading
+// the next wave), then writes the slot ids the GEMM indexes - see plan_waves_locked / stage_wave_locked
+// / emit_wave_slots. The router's expert choice is untouched, so the output matches a non-streamed run.
+void llama_moe_stream_wave_ids(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    auto * ud  = (llama_moe_stream_wave *) userdata;
+    auto * sl  = ud->sl;
+    auto * mgr = sl->mgr;
+
+    const int32_t w = ud->wave;
+
+    const ggml_tensor * a = dst->src[0]; // contiguous selected ids
+    GGML_ASSERT(a->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_nelements(dst) == ggml_nelements(a));
+    GGML_ASSERT(dst->data != a->data); // the emit must not clobber the ids other waves read
+
+    const int64_t   n   = ggml_nelements(a);
+    const int32_t * ids = (const int32_t *) a->data;
+          int32_t * out = (int32_t *) dst->data;
+
+    std::unique_lock<std::mutex> lk(mgr->mtx);
+
+    if (mgr->load_failed) {
+        GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+    }
+
+    mgr->stats.n_wave_calls++;
+
+    if (w == 0) {
+        mgr->plan_waves_locked(*sl, ids, n);
+    }
+    GGML_ASSERT(sl->plan_next_wave == w); // waves must run in order (enforced by the graph ordering token)
+
+    const uint32_t n_ids = (uint32_t) a->ne[0]; // experts per token (n_expert_used)
+
+    mgr->stage_wave_locked(lk, *sl, w, n_ids); // make this wave resident, preload the next, build the pool
+    sl->plan_next_wave = w + 1;
+
+    mgr->emit_wave_slots(*sl, ids, out, w, n_ids, a->ne[1]);
+}
+
+// multi-pass prefill: 1.0 for pairs whose expert belongs to wave w, 0.0 otherwise; multiplied into
+// this wave's expert GEMM output so the masked-out (parked) pairs contribute nothing to the sum
+void llama_moe_stream_wave_mask(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    auto * ud  = (llama_moe_stream_wave *) userdata;
+    auto * sl  = ud->sl;
+    auto * mgr = sl->mgr;
+
+    const int32_t w = ud->wave;
+
+    const ggml_tensor * a = dst->src[0]; // contiguous selected ids
+    GGML_ASSERT(a->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_nelements(dst) == ggml_nelements(a));
+
+    const int64_t   n   = ggml_nelements(a);
+    const int32_t * ids = (const int32_t *) a->data;
+          float   * out = (float *) dst->data;
+
+    std::lock_guard<std::mutex> lock(mgr->mtx);
+
+    GGML_ASSERT(sl->plan_next_wave > w); // this wave's ids op has already run
+
+    for (int64_t i = 0; i < n; i++) {
+        out[i] = sl->expert_wave[ids[i]] == (uint8_t) w ? 1.0f : 0.0f;
+    }
+}
diff --git a/src/llama-moe-stream.h b/src/llama-moe-stream.h
new file mode 100644
index 000000000..f58584595
--- /dev/null
+++ b/src/llama-moe-stream.h
@@ -0,0 +1,375 @@
+#pragma once
+
+#include "llama-mmap.h"
+
+#include "ggml-cpp.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+// SSD streaming of MoE routed expert weights
+//
+// Streamed layers do not materialize their ffn_*_exps tensors; instead each weight gets a
+// device-side cache tensor of n_slots expert slabs, filled on demand from the GGUF file by an
+// id-remapping custom op that runs on the CPU right after the router top-k. The remap only
+// changes which cache slot an expert id resolves to - it never changes which experts the router
+// selected, so streaming affects latency, not outputs.
+//
+// Missing experts are loaded by a pool of I/O threads while the remap op waits; eviction is by
+// decaying route hotness with an LRU tiebreak. Reads are buffered by default, or O_DIRECT with
+// LLAMA_MOE_STREAM_DIRECT=1 (bypasses the page cache; recommended when the model far exceeds RAM).
+//
+// note: multiple contexts decoding the same streamed model concurrently are not supported -
+// one context can evict slots referenced by the other's in-flight graph.
+
+struct llama_moe_stream;
+
+enum llama_moe_stream_slot_state : uint8_t {
+    LLAMA_MOE_STREAM_SLOT_EMPTY    = 0,
+    LLAMA_MOE_STREAM_SLOT_LOADING  = 1, // reserved, load queued or in flight
+    LLAMA_MOE_STREAM_SLOT_RESIDENT = 2,
+};
+
+// one streamed weight tensor (gate/up/down or fused gate_up) of one layer
+struct llama_moe_stream_weight {
+    ggml_tensor * cache = nullptr; // cache tensor {ne0, ne1, n_slots}
+    ggml_tensor * full  = nullptr; // the memory-mapped full exps tensor, when kept for large batches (may be null)
+    ggml_tensor * stage = nullptr; // full-layer staging tensor {ne0, ne1, n_expert} for large batches (may be null)
+
+    // metadata of the full tensor, for the staging tensors
+    ggml_type type    = GGML_TYPE_F32;
+    int64_t   ne0     = 0;
+    int64_t   ne1     = 0;
+    size_t    nb_full = 0; // bytes of the full tensor
+    size_t    stage_off = 0; // byte offset of this weight's region within a staging set
+
+    uint16_t file_idx  = 0; // GGUF split file index
+    size_t   offs      = 0; // file offset of the full exps tensor data
+    size_t   nb_expert = 0; // bytes per expert slab
+
+    // demand loads read each expert slab in n_chunks pieces of chunk_bytes (4 KiB multiple) so that
+    //   several I/O threads work on one tensor; the latency of one large read is what stalls decode
+    int32_t n_chunks    = 1;
+    size_t  chunk_bytes = 0;
+};
+
+struct llama_moe_stream_layer;
+
+// userdata of one wave's custom ops (multi-pass prefill): identifies which pass this is
+struct llama_moe_stream_wave {
+    llama_moe_stream_layer * sl   = nullptr;
+    int32_t                  wave = -1;
+};
+
+// per-layer streaming state - also the userdata of the id-remapping custom op
+struct llama_moe_stream_layer {
+    llama_moe_stream * mgr = nullptr;
+
+    int32_t  il       = -1;
+    uint32_t n_expert = 0;
+    uint32_t n_slots  = 0;
+
+    std::vector<llama_moe_stream_weight> weights; // 2 (fused gate_up + down) or 3 entries
+
+    int32_t stage_set = -1; // staging set (0/1) this layer's large-batch tensors live in, -1 = none
+
+    // decode prefetch: the next streamed layer and its router. during a decode step this layer applies
+    //   the next layer's router to its own MoE input, and the experts that scores highest start loading
+    //   into the next layer's cache while this layer computes (see llama_moe_stream_prefetch). the router
+    //   of the next layer still makes the real choice from its own input - a wrong guess costs bandwidth
+    //   and a cache slot, never a different output
+    llama_moe_stream_layer * next = nullptr;
+    ggml_tensor * next_gate_inp    = nullptr;
+    ggml_tensor * next_exp_probs_b = nullptr;
+    std::vector<uint8_t> slot_prefetched; // [n_slots] filled by a prefetch and not yet selected by the router (guarded by mgr->mtx)
+    std::vector<uint8_t> pf_keep;         // scratch of the prefetch op
+
+    // residency state, guarded by mgr->mtx
+    std::vector<int32_t>                 slot_expert;   // [n_slots] expert id or -1
+    std::vector<uint8_t>                 slot_state;    // [n_slots] llama_moe_stream_slot_state
+    std::vector<uint32_t>                slot_claimed;  // [n_slots] bitmask over (part, chunk): pieces a worker owns
+    std::vector<uint8_t>                 slot_parts_left; // [n_slots] pieces still to load (LOADING only)
+    std::vector<uint64_t>                slot_gen;      // [n_slots] reservation generation
+    std::vector<int64_t>                 slot_last_use; // [n_slots] LRU stamps
+    std::unordered_map<int32_t, int32_t> expert_slot;   // RESIDENT and LOADING entries
+
+    std::vector<uint32_t> route_hotness; // [n_expert] decayed selection counts, for eviction
+    std::vector<uint8_t>  seen;          // [n_expert] for cold-miss attribution
+    int64_t use_counter = 0;
+
+    // scratch for the remap callback
+    std::vector<int32_t> uniq;
+    std::vector<uint8_t> touched;
+    std::vector<uint8_t> keep;         // [n_slots] slots the current call must not evict
+    std::vector<int32_t> demand_slots; // slots the current call waits on
+
+    // wave plan for multi-pass prefill (guarded by mgr->mtx): the touched experts are split into
+    // plan_n_waves passes of at most plan_capacity experts each, run one pass at a time
+    uint32_t plan_capacity  = 0;  // experts per wave, set at graph build
+    uint32_t plan_n_waves   = 0;  // waves of the current call
+    int32_t  plan_next_wave = -1; // wave expected to run next (ordering guard)
+    std::vector<uint8_t> expert_wave; // [n_expert] wave each touched expert belongs to, 0xff = untouched
+    std::vector<int32_t> plan_pool;   // resident slots the masked-out pairs of this wave park on
+    std::vector<int32_t> pool_used;   // scratch: pool slots already used in the current token row
+
+    std::vector<std::unique_ptr<llama_moe_stream_wave>> wave_ud; // stable per-wave op userdata
+
+    // stable userdata for wave w (grows lazily); called at graph build time only
+    llama_moe_stream_wave * wave_userdata(int32_t wave, uint32_t capacity);
+
+    // whether the exps tensors passed to build_moe_ffn are this layer's cache tensors
+    // (e.g. grovemoe evaluates a second, unstreamed expert group on the same layer index)
+    bool matches(const ggml_tensor * gate, const ggml_tensor * up,
+                 const ggml_tensor * down, const ggml_tensor * gate_up) const;
+
+    // the memory-mapped full tensor behind a cache tensor, or null when not kept
+    ggml_tensor * full_of(const ggml_tensor * cache) const;
+
+    // the full-layer staging tensor behind a cache tensor, or null when staging is off
+    ggml_tensor * stage_of(const ggml_tensor * cache) const;
+
+    bool has_stage() const { return stage_set >= 0; }
+};
+
+// one queued expert load: one weight tensor (gate/up/down) of one expert, so the parts of an expert
+//   are read by different I/O threads in parallel and the slot commits when the last part lands
+struct llama_moe_stream_work {
+    llama_moe_stream_layer * sl = nullptr;
+
+    int32_t  expert = -1;
+    int32_t  slot   = -1;
+    uint64_t gen    = 0; // stale unless it matches slot_gen[slot]
+    int32_t  part   = 0; // index into sl->weights
+    int32_t  chunk  = 0; // piece of that weight's expert slab
+};
+
+// one staging read: a contiguous file range of a GGUF split into the staging set. which disk it is
+//   read from is not decided here - a chunk is claimed by whichever reader is free next, and the
+//   reader's own disk serves it (see stage_start_async)
+struct llama_moe_stage_chunk {
+    uint16_t  file_idx = 0;
+    size_t    off      = 0;
+    size_t    len      = 0;
+    uint8_t * dst      = nullptr;
+};
+
+// one expert slab that staging copies out of the RAM expert cache instead of reading it from disk.
+//   the slot is only trusted if it still holds the same expert at the same generation when the layer is
+//   consumed - otherwise a demand load may have replaced it mid-copy, and the slab is re-read from disk
+struct llama_moe_stage_copy {
+    int32_t         part   = 0;  // weight index
+    int32_t         expert = -1;
+    int32_t         slot   = -1;
+    uint64_t        gen    = 0;
+    const uint8_t * src    = nullptr;
+    uint8_t       * dst    = nullptr;
+    size_t          len    = 0;
+};
+
+struct llama_moe_stream {
+    uint32_t n_slots      = 0; // expert cache slots per streamed layer
+    int32_t  n_io_threads = 0;
+
+    std::vector<std::unique_ptr<llama_moe_stream_layer>> layers; // [n_layer], null = not streamed
+
+    llama_moe_stream(uint32_t n_layer, uint32_t n_slots, int32_t n_io_threads, bool direct);
+    ~llama_moe_stream();
+
+    llama_moe_stream_layer * layer(int32_t il) const {
+        return il >= 0 && (size_t) il < layers.size() ? layers[il].get() : nullptr;
+    }
+
+    // registers a streamed weight of layer il and returns its cache tensor
+    ggml_tensor * create_cache_tensor(
+            int32_t il, ggml_backend_buffer_type_t buft, const ggml_tensor * meta,
+            uint16_t file_idx, size_t offs, ggml_tensor * full = nullptr);
+
+    // allocate the cache tensor buffers (after all create_cache_tensor calls)
+    void alloc_bufs(bool no_alloc);
+
+    // full-layer staging for large batches (prefill): a ubatch of a few hundred tokens touches nearly
+    //   every expert of a layer, so instead of the slot cache the whole expert tensors of the layer are
+    //   read into one of two host staging sets with a few large (O_DIRECT) reads, and the next streamed
+    //   layer is read into the other set while this one computes. op offload then copies only the
+    //   used experts to the device. no eviction, no id remapping. LLAMA_MOE_STREAM_STAGE=0 disables it.
+    bool use_staging = true;
+    void alloc_staging(); // after alloc_bufs + open_files
+    void stage_layer(llama_moe_stream_layer & sl); // make the layer's staging tensors resident, prefetch the next
+
+    std::vector<uint8_t *>              stage_base;  // [2] aligned host blocks
+    // device backends to synchronize before a staging set is overwritten: op offload enqueues the used-expert
+    //   copies asynchronously (cudaMemcpyAsync from pageable memory is not guaranteed to have read its source
+    //   when it returns, e.g. with HMM), so the previous layer's set may still be in flight
+    std::vector<ggml_backend_t>         sync_backends;
+    std::vector<std::pair<ggml_backend_reg_t, uint8_t *>> stage_pinned; // sets registered as pinned host memory
+    size_t                              stage_bytes = 0;
+    std::vector<ggml_backend_buffer_ptr> stage_bufs; // [2] CPU buffers wrapping the blocks
+    ggml_context_ptr                    stage_ctx;
+    std::vector<size_t>                 stage_region_off;  // per weight index: offset within a set
+    std::vector<size_t>                 stage_region_size;
+
+    struct {
+        int32_t                  il = -1; // layer being read, -1 = idle
+        std::vector<std::thread> threads;
+        std::atomic<bool>        failed{false};
+        // the layer's reads and the cursor the readers pull them from. only written while no reader
+        //   runs (stage_join clears threads before stage_start_async refills this)
+        std::vector<llama_moe_stage_chunk> chunks;
+        std::atomic<size_t>                cursor{0};
+        // experts copied out of the RAM expert cache instead (LLAMA_MOE_STREAM_STAGE_CACHE), same rules
+        std::vector<llama_moe_stage_copy>  copies;
+        std::atomic<size_t>                copy_cursor{0};
+    } stage_pending;
+    std::mutex stage_mtx;
+
+    // staging takes the experts that are already resident in the RAM expert cache from there (a memcpy)
+    //   and reads only the rest from disk. the decode keeps the most used experts of every layer in the
+    //   cache, about a quarter of each layer with a 32 GiB cache, so a warm cache saves that share of the
+    //   disk bytes of every prefill ubatch. LLAMA_MOE_STREAM_STAGE_CACHE=0 reads everything from disk
+    bool    stage_use_cache = true;
+    int32_t n_copy_threads  = 2; // threads doing the cache copies, next to the disk readers
+
+    struct {
+        int64_t n_layers   = 0; // staged layer loads
+        int64_t n_prefetch = 0; // of which arrived prefetched
+        int64_t t_wait_us  = 0; // time spent waiting for staging reads
+        int64_t t_sync_us  = 0; // time spent waiting for the device before overwriting a set
+        int64_t n_bytes    = 0; // read from disk
+        std::atomic<int64_t> n_bytes_mirror{0}; // of which came off the mirror disk
+        int64_t n_bytes_cache = 0; // copied out of the RAM expert cache instead
+        int64_t n_copy_stale  = 0; // cache copies whose slot changed underneath, re-read from disk
+    } stage_stats;
+
+    void stage_start_async(llama_moe_stream_layer & sl);
+    void stage_check_copies(llama_moe_stream_layer & sl); // after the join: re-read cache copies that went stale
+    void stage_assign_set(llama_moe_stream_layer & sl, int32_t set); // retarget the layer's staging tensors
+    void stage_sync_devices();
+    void stage_join();
+    llama_moe_stream_layer * stage_next(int32_t il) const;
+
+    // reopen the GGUF files for streaming reads
+    void open_files(const std::vector<std::string> & paths);
+
+    size_t size_bufs() const;
+
+    void print_stats() const;
+
+    bool use_direct_io = false; // O_DIRECT streaming reads (LLAMA_MOE_STREAM_DIRECT), no page cache
+
+    llama_files files; // privately reopened GGUF files, same indices as the loader's
+    std::vector<std::string> file_paths; // their paths (diagnostics)
+
+    // optional mirror copy of the GGUF files on a second disk (LLAMA_MOE_STREAM_MIRROR=<dir>) so both
+    //   disks deliver bandwidth at the same time. staging pulls from a shared queue with mirror_threads
+    //   of the readers on the mirror (see stage_start_async). the demand path of the decode uses the
+    //   mirror when mirror_decode_every > 0: by default the same way - mirror_decode_threads of the
+    //   demand workers read only the mirror, the rest only the primary disk, all pulling from the one
+    //   demand queue (see worker_loop). LLAMA_MOE_STREAM_DECODE_QUEUE=0 restores the old fixed share
+    //   (every mirror_decode_every-th piece off the mirror), and mirror_every is the fixed staging share
+    //   of the old staging scheduler (LLAMA_MOE_STREAM_STAGE_QUEUE=0)
+    llama_files mirror_files; // same indices as files, empty when no mirror
+    int32_t mirror_every          = 0; // 0 = off
+    int32_t mirror_decode_every   = 0; // 0 = off
+    int32_t mirror_threads        = 0; // staging readers serving the mirror, rest serve the primary disk
+    int32_t mirror_decode_threads = 0; // demand workers serving the mirror (decode queue mode)
+    bool    stage_queue           = true; // shared chunk queue instead of the fixed per-thread stride
+    bool    decode_queue          = true; // demand workers split into a pool per disk instead of the fixed piece share
+
+    int32_t n_demand_threads = 0; // demand-load workers (LLAMA_MOE_STREAM_DECODE_THREADS, default n_io_threads)
+
+    // staging chunk sizes: chunks of stage_chunk_max, shrinking towards the end of a layer (guided
+    //   self-scheduling, never below stage_chunk_min) so the readers run dry at nearly the same moment
+    //   instead of waiting on the last few large reads. LLAMA_MOE_STREAM_STAGE_GUIDED=0 keeps them fixed
+    size_t stage_chunk_max = 32ull << 20;
+    size_t stage_chunk_min = 4ull << 20;
+    bool   stage_guided    = true;
+
+    size_t  max_nb_expert      = 0;
+    int64_t hot_decay_interval = 0; // remap calls between route-hotness halvings (0 = no decay)
+
+    std::vector<std::pair<ggml_backend_buffer_type_t, ggml_context_ptr>> ctxs; // one per buft
+    std::vector<ggml_backend_buffer_ptr> bufs;
+
+    // load pool (queue and all layer residency state guarded by mtx)
+    mutable std::mutex      mtx;
+    std::condition_variable cv_work; // queued work or shutdown
+    std::condition_variable cv_done; // a load committed or failed
+
+    std::deque<llama_moe_stream_work> q_demand;
+    std::deque<llama_moe_stream_work> q_prefetch; // served only when q_demand is empty
+
+    // experts of the next layer predicted and prefetched per decode step (LLAMA_MOE_STREAM_PREFETCH, 0 = off)
+    int32_t prefetch_n    = 0;
+    int32_t prefetch_pool = 1;     // 1 = only the mirror's demand workers take prefetches (LLAMA_MOE_STREAM_PREFETCH_POOL, 0 = all)
+    bool    prefetch_dry  = false; // LLAMA_MOE_STREAM_PREFETCH_DRY: predict but load nothing (diagnostic)
+
+    std::vector<std::thread> workers;
+    bool workers_started = false;
+    bool shutting_down   = false;
+    bool load_failed     = false;
+
+    bool debug = false;
+    int64_t t_start_us = 0;
+
+    struct {
+        int64_t n_calls     = 0; // remap invocations
+        int64_t n_hit       = 0; // touched experts already resident or loading
+        int64_t n_miss      = 0; // demand loads issued
+        int64_t n_miss_cold = 0; // first-ever touch of an expert
+        int64_t t_stall_us  = 0; // wait time in miss handling
+
+        int64_t n_wave_calls     = 0; // wave-ids invocations (>= n_calls under multi-pass prefill)
+        int64_t n_waves_run      = 0; // non-empty waves
+        int64_t n_preload_issued = 0; // next-wave loads started during a wave's compute
+        int64_t n_preload_ready  = 0; // wave experts already resident from the previous preload
+        int64_t t_stall_wave_us  = 0; // wait time in wave miss handling
+
+        int64_t n_demand_bytes        = 0; // bytes read by the demand workers
+        int64_t n_demand_bytes_mirror = 0; // of which off the mirror disk
+
+        int64_t n_pf_issued = 0; // experts the decode prefetch started loading
+        int64_t n_pf_used   = 0; // of which the router then selected
+        int64_t n_pf_wasted = 0; // of which were evicted again unused
+    } stats;
+
+    // internals
+    void start_workers_locked();
+    void worker_loop(int32_t idx);
+    int32_t pick_victim_locked(llama_moe_stream_layer & sl, const uint8_t * keep) const;
+    void reserve_slot_locked(llama_moe_stream_layer & sl, int32_t expert, int32_t slot);
+    void enqueue_load_locked(llama_moe_stream_layer & sl, int32_t expert, int32_t slot, bool prefetch = false); // one work item per weight part
+    void prefetch_locked(llama_moe_stream_layer & sl, const int32_t * ids, int64_t n); // start loading predicted experts
+
+    // multi-pass prefill helpers (called by llama_moe_stream_wave_ids, all under mtx)
+    void plan_waves_locked(llama_moe_stream_layer & sl, const int32_t * ids, int64_t n); // wave 0: build the plan
+    void stage_wave_locked(std::unique_lock<std::mutex> & lk, llama_moe_stream_layer & sl, int32_t w, uint32_t n_ids); // make wave w resident + preload next
+    void emit_wave_slots(llama_moe_stream_layer & sl, const int32_t * ids, int32_t * out, int32_t w, uint32_t n_ids, int64_t n_tok); // write the slot ids
+};
+
+// callback of the id-remapping custom op inserted by build_moe_ffn
+void llama_moe_stream_remap(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata);
+
+// callback of the decode prefetch op inserted by build_moe_ffn (userdata = the NEXT layer): a = the
+//   experts predicted for the next layer [k, n_tokens], b = this layer's remapped ids (only orders the op
+//   after this layer's own loads). returns immediately, the loads run on the I/O workers
+void llama_moe_stream_prefetch(ggml_tensor * dst, const ggml_tensor * a, const ggml_tensor * b, int ith, int nth, void * userdata);
+
+// callback of the full-layer staging op inserted by build_moe_ffn for large batches: passes the ids
+//   through unchanged and makes the layer's staging tensors resident (userdata = the layer)
+void llama_moe_stream_stage(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata);
+
+// callbacks of the multi-pass prefill custom ops inserted by build_moe_ffn when a ubatch touches
+// more experts than the cache holds; each src[0] is the contiguous selected ids
+//   wave_ids:  makes wave w's expert slice resident and emits slot ids (masked pairs park on a pool)
+//   wave_mask: emits 1.0 for pairs belonging to wave w, 0.0 otherwise
+void llama_moe_stream_wave_ids (ggml_tensor * dst, int ith, int nth, void * userdata);
+void llama_moe_stream_wave_mask(ggml_tensor * dst, int ith, int nth, void * userdata);
